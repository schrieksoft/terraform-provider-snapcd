{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "gitAuthor": "snapcd-bot <noreply@snapcd.io>",
  "labels": ["dependencies"],

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": [
        "SNAPCD_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "schrieksoft/snapcd",
      "datasourceTemplate": "github-releases"
    }
  ],

  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "groupName": "snapcd",
      "commitMessageTopic": "snapcd images",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "matchPackageNames": [
        "/^ghcr\\.io\\/schrieksoft\\/snapcd/"
      ],
      "enabled": true
    },
    {
      "groupName": "snapcd-openapi",
      "commitMessageTopic": "snapcd OpenAPI document",
      "matchPackageNames": [
        "schrieksoft/snapcd"
      ],
      "enabled": true
    }
  ],
  "prHourlyLimit": 10,
  "prConcurrentLimit": 25,
  "branchConcurrentLimit": 25,
  "baseBranchPatterns": ["main"]
}
